<main class="handle-page">
	<section class="handle-card" aria-labelledby="handle-title">
		<div class="auth-brand">
			<img src="/images/task_icon_final_transparent.png" alt="manage logo" class="brand-logo">
			<span>manage</span>
		</div>

		<% if (httpStatus === 200) { %>
			<p class="handle-icon handle-icon-success" aria-hidden="true">&#10003;</p>
			<p class="eyebrow">All set</p>
			<h1 id="handle-title">Account created.</h1>
			<p class="handle-message"><%= message %></p>
			<a class="handle-button" href="/">Continue to sign in <span aria-hidden="true">&#8594;</span></a>
		<% } else if (httpStatus === 400) { %>
			<p class="handle-code">400</p>
			<p class="eyebrow">Invalid input</p>
			<h1 id="handle-title">Please check your input.</h1>
			<p class="handle-message"><%= message %></p>
			<a class="handle-button" href="javascript:history.back()">Try again <span aria-hidden="true">&#8594;</span></a>
		<% } else if (httpStatus === 401) { %>
			<p class="handle-code">401</p>
			<p class="eyebrow">Access denied</p>
			<h1 id="handle-title">Please check your login details.</h1>
			<p class="handle-message"><%= message %></p>
			<a class="handle-button" href="/">Try again <span aria-hidden="true">&#8594;</span></a>
		<% } else if (httpStatus === 404) { %>
			<p class="handle-code">404</p>
			<p class="eyebrow">Not found</p>
			<h1 id="handle-title">We could not find what you're looking for.</h1>
			<p class="handle-message"><%= message %></p>
			<a class="handle-button" href="/dashboard">Go back <span aria-hidden="true">&#8592;</span></a>
		<% } else { %>
			<p class="handle-code">500</p>
			<p class="eyebrow">Something went wrong</p>
			<h1 id="handle-title">We could not process your request.</h1>
			<p class="handle-message"><%= message %></p>
			<a class="handle-button" href="/">Back <span aria-hidden="true">&#8592;</span></a>
		<% } %>
	</section>
</main>